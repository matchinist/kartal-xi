.heroStrip {
  padding: 32px 24px 24px;
  border-bottom: 0.5px solid var(--border);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
}

.heroTitle {
  font-family: var(--cond);
  font-weight: 900;
  font-size: 56px;
  line-height: 0.9;
  letter-spacing: 2px;
  color: #fff;
  text-transform: uppercase;
}

.heroTitle span { color: var(--gold); }
.heroMeta { text-align: right; }

.heroMetaLine {
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--text-dim);
  text-transform: uppercase;
  margin-bottom: 3px;
}

.heroSeason {
  font-family: var(--cond);
  font-weight: 700;
  font-size: 22px;
  color: var(--gold);
  letter-spacing: 2px;
}

.mainGrid {
  display: grid;
  grid-template-columns: 1fr 320px;
  border-bottom: 0.5px solid var(--border);
}

.leftCol {
  border-right: 0.5px solid var(--border);
}

.sidebar {}

.secLabel {
  padding: 14px 16px 10px;
  font-size: 9px;
  letter-spacing: 3px;
  color: var(--text-dim);
  text-transform: uppercase;
  border-bottom: 0.5px solid var(--border);
}

.secLabel::before {
  content: '// ';
  color: var(--text-dimmer);
}

.scorerRow {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-bottom: 0.5px solid var(--border);
}

.rank {
  font-family: var(--cond);
  font-size: 18px;
  color: var(--text-dimmer);
  min-width: 16px;
}

.info { flex: 1; }

.name {
  font-size: 11px;
  color: var(--text);
}

.pos {
  font-size: 9px;
  color: var(--text-dim);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-top: 2px;
}

.goals {
  font-family: var(--cond);
  font-weight: 700;
  font-size: 22px;
  color: var(--gold);
}

.stRow {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-bottom: 0.5px solid var(--border);
  font-size: 11px;
}

.stRow:last-child { border-bottom: none; }
.stRow.me { background: #110f00; }

.stPos { color: var(--text-dim); min-width: 14px; font-size: 10px; }
.stPos.champ { color: #4a8fd4; }
.stPos.gold { color: var(--gold); }

.stName { flex: 1; color: #888; }
.stName.gold { color: var(--gold); }

.stPts {
  font-family: var(--cond);
  font-size: 16px;
  color: #fff;
}

.stGd { font-size: 9px; color: var(--text-dim); min-width: 28px; text-align: right; }
.stGd.gold { color: var(--gold); }

.footer {
  border-top: 0.5px solid var(--border);
  padding: 14px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 9px;
  color: var(--text-dimmer);
  letter-spacing: 1.5px;
}

.gold { color: var(--gold); }
